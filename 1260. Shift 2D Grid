class Solution {
public:
    vector<vector<int>> shiftGrid(vector<vector<int>>& grid, int k) {
        vector<vector<int>> g;
        int m=grid.size();
        int n=grid[0].size();
        g.resize(m,vector<int>(n,0));
        if(k==0)
          return grid;
        for(int a=0;a<k;a++){
            if(a!=0){
                grid=g;
            }
            g.assign(m, vector<int>(n, 0));
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(i==m-1 && j==n-1){
                    g[0][0]=grid[m - 1][n - 1];
                }
                else if(j==n-1 ){
                    g[i + 1][0]=grid[i][j];
                }
                else{
                    g[i][j+1]=grid[i][j];
                }
            }
        }
        }
        return g;
    }
};
