class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        
        int l=0,r=numbers.size()-1;
        while(l<r){
            int a=numbers[l]+numbers[r];
            if(a==target){
                return {l+1,r+1};
            }
            else if(a<target){
                l++;
            }
            else{
                r--;
            }
        }
        return {l+1,r+1};
    }
};
